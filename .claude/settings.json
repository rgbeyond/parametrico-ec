{
  "enabledPlugins":{"security-guidance@claude-plugins-official":true},
  "permissions":{"defaultMode":"auto","disableBypassPermissionsMode":"disable","allow":["Read","Glob","Grep","Bash(git status *)","Bash(git diff *)","Bash(git log *)","Bash(git fetch *)","Bash(npm test)","Bash(npm run build)"],"deny":["Read(./.env)","Read(./.env.*)","Edit(./.env)","Edit(./.env.*)","Write(./.env)","Write(./.env.*)","Bash(git reset --hard *)","Bash(git clean -fd*)","Bash(git push --force*)","Bash(git push -f *)"]},
  "hooks":{"PreToolUse":[{"matcher":"Bash|PowerShell|mcp__.*","hooks":[{"type":"command","command":"python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/beyond_guard.py\"","timeout":5}]}],"PermissionRequest":[{"matcher":"*","hooks":[{"type":"command","command":"python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/explain_permission.py\"","timeout":5}]}]}
